@article{McGraw1992-ae,
  title     = "A common language effect size statistic",
  author    = "McGraw, Kenneth O and Wong, S P",
  journal   = "Psychol. Bull.",
  publisher = "American Psychological Association (APA)",
  volume    =  111,
  number    =  2,
  pages     = "361--365",
  abstract  = "Some of the shortcomings in interpretability and generalizability
               of the effect size statistics currently available to researchers
               can be overcome by a statistic that expresses how often a score
               sampled from one distribution will be greater than a score
               sampled from another distribution. The statistic, the common
               language effect size indicator, is easily calculated from sample
               means and variances (or from proportions in the case of
               nominal-level data). It can be used for expressing the effect
               observed in both independent and related sample designs and in
               both 2-group and n-group designs",
  month     =  mar,
  year      =  1992,
  language  = "en"
}
